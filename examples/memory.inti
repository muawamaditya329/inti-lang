# memory.inti — memori langsung: alloc, store, load, free
# Arena = memori nyata di host; alamat = offset ke dalam arena.

data nl, "\n"

# 1) blok 8 byte (satu int64)
set p, 0
alloc p, 8
store p, 123456789012345
load v, p
printi v
prints nl, 1

# 2) isi 10 elemen array, jumlahkan
set arr, 0
alloc arr, 80            # 10 x 8 byte

set i, 0
isi:
    set t, arr
    mul off, i, 8
    add t, off           # t = arr + i*8
    mul val, i, i        # val = i*i
    store t, val
    add i, 1
    cmp i, 10
    jl isi

set sum, 0
set i, 0
jumlah:
    set t, arr
    mul off, i, 8
    add t, off
    load v, t
    add sum, v
    add i, 1
    cmp i, 10
    jl jumlah

printi sum               # 0^2 + 1^2 + ... + 9^2 = 285
prints nl, 1

# 3) byte per byte: bangun string "Inti!\n" lalu cetak
set b, 0
alloc b, 6
storeb b,       73       # I
storeb b+1,     110      # n
storeb b+2,     116      # t
storeb b+3,     105      # i
storeb b+4,     33       # !
storeb b+5,     10       # \n
prints b, 6

free arr
free b
free p
exit 0
