set i, 1
while i <= 15 {
    mod r3, i, 3
    mod r5, i, 5
    cmp r3, 0
    jne cek5
    cmp r5, 0
    jne cetak_fizz
    prints fb, 8
    jmp lanjut
    cek5:
    cmp r5, 0
    jne cetak_angka
    prints bz, 4
    jmp lanjut
    cetak_fizz:
    prints fz, 4
    jmp lanjut
    cetak_angka:
    printi i
    lanjut:
    printc 32
    add i, 1
}
printc 10
data fz, "Fizz"
data bz, "Buzz"
data fb, "FizzBuzz"
