    ret 0
}

# e_add_rr_rcx — add rcx, rax (48 01 modrm(11, 000, 001)=193)
fn e_add_rr_rcx {
    call _, e8, 72
    call _, e8, 1
    call _, e8, 193
    ret 0
}

# e_movb_m11_rcx_dl — mov byte [rcx], dl (88 11)
fn e_movb_m11_rcx_dl {
    call _, e8, 136
    call _, e8, 17
    ret 0
}

# emit_printi — printi x  (panggil __printi program hasil)
fn emit_printi {
    load k, G+600
    load v, G+608
    load o, G+616
    call _, ld_operand, 0, k, v, o     # rax = nilai
    call _, e_mov_rr, 7, 0             # rdi = rax
    load ln, G+288
    set hp, -1
    call _, e_call_f, hp, ln           # call __printi (hidden, tgt=-1)
    ret 0
}

# emit_prints — prints alamat, byte
fn emit_prints {
    load k, G+600
    load v, G+608
    load o, G+616
    call _, ld_operand, 0, k, v, o     # rax = onnset
    load k, G+624
    load v, G+632
    load o, G+640
    call _, ld_operand, 1, k, v, o     # rcx = panjang
    call _, e_mov_rr, 2, 1             # rdx = rcx
    call _, e_ld_glob_r11, 0           # r11 = base
    call _, e_mov_r_r11, 6             # rsi = r11
    call _, e_alu_rr, 1, 6, 0          # add rsi, rax
    call _, e_mov_edi_imm, 1
    call _, e_mov_ri32, 0, 1           # rax = SYS_write
    call _, e_syscall
    ret 0
}

# e_ld_glob_r11(goff) — mov r11, [abs disp32] (REX.W|R|B = 0x4D)
fn e_ld_glob_r11, goff {
    call _, e8, 77
    call _, e8, 139
    call _, e8, 28                     # modrm(00, 011, 100) = 0x1C
    call _, e8, 37                     # SIB 0x25
    call _, e32, 0
    set g, goff
    call _, fix_push, 6, g, 0
    ret 0
}

# emit_printc — printc kode (byte disimpan sementara di GENIMG+86)
fn emit_printc {
    load k, G+600
    load v, G+608
    load o, G+616
    call _, ld_operand, 0, k, v, o     # rax = kode byte
    call _, e_mov_rr, 2, 0             # rdx = kode
    call _, e_ld_glob_r11, 0           # r11 = base
    call _, e8, 65                     # mov byte [r11+86], dl (41 88 53 56)
    call _, e8, 136
    call _, e8, 83
    call _, e8, 86
    call _, e_mov_edi_imm, 1
    call _, e_mov_r_r11, 6             # rsi = base
    call _, e_add_r_imm32, 6, 86
    call _, e_mov_edx_imm, 1
    call _, e_mov_ri32, 0, 1
    call _, e_syscall
    ret 0
}

# e_mov_r_r11 diperluas: dst boleh r8..r15 (REX.B)
# (versi baru di bawah menimpa deninisi lama saat pemakaian nyata —
#  inti tidak mendukung redeninisi, jadi versi lama dipakai utk dst<8;
#  utk dst>=8 gunakan e_mov_r_r11_hi)

fn e_mov_r_r11_hi, reg {
    call _, e8, 77                     # REX.W|R|B
    call _, e8, 137
    set r2, reg
    and r2, 7
    set t, 216
    add t, r2
    call _, e8, t
    ret 0
}

# e_add_r_imm32(reg, imm) — add reg, imm32 (REX.W|B utk reg>=8)
fn e_add_r_imm32, reg, imm {
    set r2, reg
    set x, 72
    cmp r2, 8
    jl ari32_no
    set x, 73
    add r2, -8
ari32_no:
    call _, e8, x
    call _, e8, 129
    set t, 192
    add t, r2
    call _, e8, t
    set v, imm
    call _, e32, v
    ret 0
}

# e_add_r_rax(reg) — add reg, rax (REX.W|B utk reg>=8)
fn e_add_r_rax, reg {
    set r2, reg
    set x, 72
    cmp r2, 8
    jl arrax_no
    set x, 73
    add r2, -8
arrax_no:
    call _, e8, x
    call _, e8, 1
    set t, 192
    add t, r2
    call _, e8, t
    ret 0
}

# sys_arg_reg(idx) -> G+224 = register argumen ke-idx: rdi rsi rdx r10 r8 r9
fn sys_arg_reg, idx {
    set i, idx
    set r, 7
    cmp i, 0
    je sar_done
    set r, 6
    cmp i, 1
    je sar_done
    set r, 2
    cmp i, 2
    je sar_done
    set r, 10
    cmp i, 3
    je sar_done
    set r, 8
    cmp i, 4
    je sar_done
    set r, 9
sar_done:
    store G+224, r
    ret r
}

# emit_sys_arg(idx, k, v, o) — isi register argumen ke-idx
fn emit_sys_arg, idx, k, v, o {
    set i, idx
    call _, sys_arg_reg, i
    load r, G+224
    set kk, k
    cmp kk, 3
    je sa_ptr
    cmp kk, 4
    je sa_ptrslot
    # nilai biasa
    call _, ld_operand, r, kk, v, o
    ret 0
sa_ptr:
    # pointer = base + val (+off)
    call _, e_ld_glob_r11, 0
    set rr, r
    cmp rr, 8
    jl sa_ptr_lo
    call _, e_mov_r_r11_hi, rr
    jmp sa_ptr_add
sa_ptr_lo:
    call _, e_mov_r_r11, rr
sa_ptr_add:
    set oo, o
    cmp oo, 0
    je sa_ptr_done
    set rr2, r
    set oo2, o
    call _, e_add_r_imm32, rr2, oo2
sa_ptr_done:
    ret 0
sa_ptrslot:
    # pointer = base + (slot + off)
    set rr3, r
    set vv, v
    set oo3, o
    call _, ld_operand, rr3, 1, vv, oo3
    call _, e_ld_glob_r11, 0
    set rr4, r
    call _, e_add_r_r11, rr4
    ret 0
}

# e_add_r_r11(reg) — add reg, r11 (REX.W|R(|B))
fn e_add_r_r11, reg {
    set r2, reg
    set x, 76                          # REX.W|R
    cmp r2, 8
    jl arr11_no
    set x, 77
    add r2, -8
arr11_no:
    call _, e8, x
    call _, e8, 1
    set t, 216
    add t, r2
    call _, e8, t
    ret 0
}

# emit_sys_nr(k, v, o) — NR -> rax lalu syscall, simpan hasil
fn emit_sys_nr, k, v, o, dk, dv, do_ {
    call _, ld_operand, 0, k, v, o
    call _, e_syscall
    call _, st_operand, dk, dv, do_, 0
    ret 0
}

# emit_call — dst, fn, args...  (args: G+360+i*24, jumlah G+356)
# Konvensi: walker mengisi G+360..: tiap arg 3 slot (k,v,o)
fn emit_call, fid {
    set n, fid
    # arity check
    set q, n
    set t5, 5
    mul q, t5
    shl q, 3            # x40
    set p, FNT
    add p, q
    add p, 8
    load ar, p
    load n, G+356
    cmp ar, n
    je ec_args
    slen t_e, E_ARI
    load ln, G+288
    call _, die_line, E_ARI, t_e, ln
ec_args:
    # argumen sudah di-push oleh walker (urutan maju) -> langsung call
ec_call:
    load ln, G+288
    set n2, fid
    call _, e_call_f, n2, ln
    load n3, G+356
    cmp n3, 0
    je ec_pop_done
    set t, 8
    mul n3, t
    call _, e_alu_i8, 0, 4, n3         # add rsp, 8n
ec_pop_done:
    load k, G+600
    load v, G+608
    load o, G+616
    call _, st_operand, k, v, o, 0     # dst <- rax
    ret 0
}

# arg_load(i) — muat argumen call ke-i ke rax (indeks eksplisit 0..5)

# emit_ret — ret [nilai]
fn emit_ret {
    # bila tidak ada nilai: rax = 0
    load k, G+624
    set kk, k
    cmp kk, -1
    je rt_zero
    load v, G+632
    load o, G+640
    call _, ld_operand, 0, kk, v, o
    jmp rt_leave
rt_zero:
    call _, e_xor_rax                  # xor rax,rax
rt_leave:
    call _, e_leave
    call _, e_ret
    ret 0
}

# emit_exit — exit kode
fn emit_exit {
    load k, G+600
    load v, G+608
    load o, G+616
    call _, ld_operand, 0, k, v, o     # rax = kode
    call _, e_mov_rr, 7, 0             # rdi = rax
    call _, e_mov_ri32, 0, 60
    call _, e_syscall                  # kernel memmask & 0xnn
    ret 0
}

# emit_slen(sid) — slen d, label  (panjang konstanta waktu-kompilasi)
fn emit_slen, sid {
    set s, sid
    call _, dl_find, s
    load r, G+224
    cmp r, -1
    jne sl_ok
    slen t_e, E_PTN
    load ln, G+288
    call _, die_line, E_PTN, t_e, ln
sl_ok:
    load r2, G+224
    call _, dl_addr, r2
    load l, G+232
    call _, ld_imm, 0, l
    load k, G+600
    load v, G+608
    load o, G+616
    call _, st_operand, k, v, o, 0
    ret 0
}

# emit_cmp_raw — cmp a, b  (simpan ke GFA/GFB utk jcc berikutnya)
fn emit_cmp_raw {
    load k, G+600
    load v, G+608
    load o, G+616
    call _, ld_operand, 0, k, v, o     # rax = a
    load k, G+624
    load v, G+632
    load o, G+640
    call _, ld_operand, 1, k, v, o     # rcx = b
    call _, e_ld_glob_r11, 0           # r11 = base
    call _, e_mov_m11_r, 0, 0          # [base+GFA] = rax   (GFA @ arena+0)
    call _, e_mov_m11_r, 1, 8          # [base+GFB] = rcx   (GFB @ arena+8)
    call _, e_alu_rr, 57, 0, 1
    ret 0
}

# emit_jcc_raw(op, sid) — reload stash lalu jcc ke label user
fn emit_jcc_raw, op, sid {
    call _, e_ld_glob_r11, 0
    call _, e_mov_r_m11, 0, 0
    call _, e_mov_r_m11, 1, 8
    call _, e_alu_rr, 57, 0, 1
    set o, op
    call _, cc_of, o
    load c, G+224
    load ln, G+288
    set s, sid
    call _, e_jcc_lbl, c, s, ln
    ret 0
}

# ======================== WALKER PERNYATAAN ========================

# endline_chk — token berjalan harus NL/RBRACE/EOF
fn endline_chk {
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 1
    je eln_ok
    cmp k, 9
    je eln_ok
    cmp k, 0
    je eln_ok
    slen t_e, E_ELN
    load ln, G+288
    call _, die_line, E_ELN, t_e, ln
eln_ok:
    ret 0
}

# skip_nl — lewati semua NL
fn skip_nl {
sk_top:
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 1
    jne sk_done
    call _, tnext
    jmp sk_top
sk_done:
    ret 0
}

# save_dst / save_src — salin hasil parse_operand ke slot dst/src
fn save_dst {
    load k, G+192
    load v, G+200
    load o, G+208
    store G+600, k
    store G+608, v
    store G+616, o
    ret 0
}

fn save_src {
    load k, G+192
    load v, G+200
    load o, G+208
    store G+624, k
    store G+632, v
    store G+640, o
    ret 0
}

# walk_body(is_main) — emit pernyataan sampai '}' (atau EOF utk __main__)
fn walk_body, is_main {
wb_top:
    call _, skip_nl
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 0
    je wb_eon
    cmp k, 9
    je wb_rbrace
    cmp k, 2
    je wb_ident
    slen t_e, E_PTN
    load ln, G+288
    call _, die_line, E_PTN, t_e, ln
wb_eon:
    set im, is_main
    cmp im, 0
    jne wb_done
    slen t_e, E_BRB
    call _, die_lbl, E_BRB, t_e
wb_rbrace:
    set im2, is_main
    cmp im2, 0
    je wb_consume
    slen t_e, E_BRB
    call _, die_lbl, E_BRB, t_e
wb_consume:
    call _, tnext
    jmp wb_done
wb_ident:
    load sid, G+176
    # label: IDENT ':' -> ikat label
    call _, peek_kind1
    load k1, G+224
    cmp k1, 7
    je wb_label
    # dispatch kata kunci (sid tetap dari intern)
    cmp sid, 0
    je wb_kw_nn
    cmp sid, 2
    je wb_in
    cmp sid, 4
    je wb_while
    cmp sid, 5
    je wb_break
    cmp sid, 6
    je wb_cont
    cmp sid, 1
    je wb_ret
    cmp sid, 8
    je wb_call
    cmp sid, 9
    je wb_cmp
    cmp sid, 10
    je wb_jmp
    cmp sid, 11
    je wb_je
    cmp sid, 12
    je wb_jne
    cmp sid, 13
    je wb_jl
    cmp sid, 14
    je wb_jle
    cmp sid, 15
    je wb_jg
    cmp sid, 16
    je wb_jge
    cmp sid, 17
    je wb_set
    cmp sid, 18
    je wb_add
    cmp sid, 19
    je wb_sub
    cmp sid, 20
    je wb_mul
    cmp sid, 21
    je wb_div
    cmp sid, 22
    je wb_mod
    cmp sid, 23
    je wb_and
    cmp sid, 24
    je wb_or
    cmp sid, 25
    je wb_xor
    cmp sid, 26
    je wb_shl
    cmp sid, 27
    je wb_shr
    cmp sid, 28
    je wb_sar
    cmp sid, 29
    je wb_neg
    cmp sid, 30
    je wb_not
    cmp sid, 31
    je wb_load
    cmp sid, 32
    je wb_store
    cmp sid, 33
    je wb_loadb
    cmp sid, 34
    je wb_storeb
    cmp sid, 35
    je wb_sys
    cmp sid, 36
    je wb_printi
    cmp sid, 37
    je wb_prints
    cmp sid, 38
    je wb_printc
    cmp sid, 39
    je wb_slen
    cmp sid, 40
    je wb_exit
    cmp sid, 41
    je wb_alloc
    cmp sid, 42
    je wb_alloc
    cmp sid, 7
    je wb_data
    jmp wb_unk
wb_label:
    call _, lbl_bind, sid
    call _, tnext
    call _, tnext
    jmp wb_top
wb_kw_nn:
    set im, is_main
    cmp im, 0
    je wb_kw_nn_err
    call _, skip_fn_body
    jmp wb_top
wb_kw_nn_err:
    slen t_e, E_PTN
    load ln, G+288
    call _, die_line, E_PTN, t_e, ln
wb_data:
    set im2, is_main
    cmp im2, 0
    je wb_data_err
    call _, skip_data_decl
    jmp wb_top
wb_data_err:
    slen t_e, E_DAT
    load ln, G+288
    call _, die_line, E_DAT, t_e, ln
wb_alloc:
    slen t_e, E_ALC
    load ln, G+288
    call _, die_line, E_ALC, t_e, ln
wb_unk:
    slen t_e, E_OPC
    slen t_n, E_OPC2
    load ln, G+288
    call _, die_line2, E_OPC, t_e, sid, E_OPC2, t_n, ln
wb_in:
    call _, st_if
    jmp wb_top
wb_while:
    call _, st_while
    jmp wb_top
wb_break:
    call _, st_bc, 1
    jmp wb_top
wb_cont:
    call _, st_bc, 0
    jmp wb_top
wb_ret:
    call _, st_ret
    jmp wb_top
wb_call:
    call _, st_call
    jmp wb_top
wb_cmp:
    call _, st_cmp
    jmp wb_top
wb_jmp:
    call _, st_jump, 124
    jmp wb_top
wb_je:
    call _, st_jump, 125
    jmp wb_top
wb_jne:
    call _, st_jump, 126
    jmp wb_top
wb_jl:
    call _, st_jump, 127
    jmp wb_top
wb_jle:
    call _, st_jump, 128
    jmp wb_top
wb_jg:
    call _, st_jump, 129
    jmp wb_top
wb_jge:
    call _, st_jump, 130
    jmp wb_top
wb_set:
    call _, st_alu_kw, 100
    jmp wb_top
wb_add:
    call _, st_alu_kw, 101
    jmp wb_top
wb_sub:
    call _, st_alu_kw, 102
    jmp wb_top
wb_mul:
    call _, st_alu_kw, 103
    jmp wb_top
wb_div:
    call _, st_alu_kw, 104
    jmp wb_top
wb_mod:
    call _, st_alu_kw, 105
    jmp wb_top
wb_and:
    call _, st_alu_kw, 106
    jmp wb_top
wb_or:
    call _, st_alu_kw, 107
    jmp wb_top
wb_xor:
    call _, st_alu_kw, 108
    jmp wb_top
wb_shl:
    call _, st_alu_kw, 109
    jmp wb_top
wb_shr:
    call _, st_alu_kw, 110
    jmp wb_top
wb_sar:
    call _, st_alu_kw, 111
    jmp wb_top
wb_neg:
    call _, st_negkw, 0
    jmp wb_top
wb_not:
    call _, st_negkw, 1
    jmp wb_top
wb_load:
    call _, st_memkw, 0
    jmp wb_top
wb_loadb:
    call _, st_memkw, 1
    jmp wb_top
wb_store:
    call _, st_memkw, 2
    jmp wb_top
wb_storeb:
    call _, st_memkw, 3
    jmp wb_top
wb_sys:
    call _, st_syskw
    jmp wb_top
wb_printi:
    call _, st_printkw, 0
    jmp wb_top
wb_prints:
    call _, st_printkw, 1
    jmp wb_top
wb_printc:
    call _, st_printkw, 2
    jmp wb_top
wb_slen:
    call _, st_slenkw
    jmp wb_top
wb_exit:
    call _, st_exitkw
    jmp wb_top
wb_done:
    ret 0
}

# st_alu_kw(op) — set/add/sub/... (2 operan)
fn st_alu_kw, op {
    load tk, G+16
    call _, tkload, tk
    load ln, G+288
    store G+288, ln
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 1
    call _, save_dst
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_src
    call _, endline_chk
    call _, tnext
    set o, op
    cmp o, 100
    jne sa1
    call _, emit_set
    ret 0
sa1:
    cmp o, 103
    jne sa2
    call _, emit_mul
    ret 0
sa2:
    cmp o, 104
    jne sa3
    set t, 0
    call _, emit_divmod, t
    ret 0
sa3:
    cmp o, 105
    jne sa4
    set t, 1
    call _, emit_divmod, t
    ret 0
sa4:
    cmp o, 109
    jne sa5
    call _, emit_shift, 4
    ret 0
sa5:
    cmp o, 110
    jne sa6
    call _, emit_shift, 5
    ret 0
sa6:
    cmp o, 111
    jne sa7
    call _, emit_shift, 7
    ret 0
sa7:
    # add/sub/and/or/xor
    set c, 1
    cmp o, 101
    je sa_emit
    set c, 41
    cmp o, 106
    je sa_emit
    set c, 9
    cmp o, 107
    je sa_emit
    set c, 49
    cmp o, 108
    je sa_emit
    set c, 41        # sub = 0x29
    cmp o, 102
    je sa_emit
    jmp sa_bad
sa_emit:
    call _, emit_bin, c
    ret 0
sa_bad:
    ret 0
}

# endline_expect_comma — token berjalan harus COMMA (konsumsi)
fn endline_expect_comma {
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 6
    je eec_ok
    slen t_e, E_PTN
    load ln, G+288
    call _, die_line, E_PTN, t_e, ln
eec_ok:
    call _, tnext
    ret 0
}

# st_negkw(is_not) — neg/not d, [s]
fn st_negkw, is_not {
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 1
    call _, save_dst
    # sumber opsional
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    set nk, -1
    store G+624, nk
    cmp k, 6
    jne sn_emit
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_src
sn_emit:
    call _, endline_chk
    call _, tnext
    set n, is_not
    call _, emit_negnot, n
    ret 0
}

# st_memkw(which) — 0 load, 1 loadb, 2 store, 3 storeb
fn st_memkw, which {
    call _, tnext
    set w, which
    cmp w, 2
    jge sm_store
    # load/loadb: d, alamat
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 1
    call _, save_dst
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_src
    call _, endline_chk
    call _, tnext
    set w2, which
    call _, emit_mem_load, w2
    ret 0
sm_store:
    # store/storeb: alamat, nilai
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_dst                  # dst = alamat
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_src                  # src = nilai
    call _, endline_chk
    call _, tnext
    set w2, which
    set b, 0
    cmp w2, 3
    jne sm_go
    set b, 1
sm_go:
    call _, emit_mem_store, b
    ret 0
}

# st_if — if kond { } [else ...]
fn st_if {
    load tk, G+16
    call _, tkload, tk
    load ln, G+288
    store G+288, ln
    call _, tnext                     # lewati 'if'
    load tk, G+16
    call _, tkload, tk
    call _, parse_cond
    call _, emit_cond_direct
    load s_nalse, G+224               # target jn (kondisi salah)
    call _, expect_lbrace
    call _, tnext
    call _, walk_body, 0
    # else?
    call _, save_pos
    call _, skip_nl
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 2
    jne si_noelse
    load sid, G+176
    cmp sid, 3
    jne si_restore
    call _, tnext                     # lewati 'else'
    # lompati blok else
    load ln2, G+288
    call _, e_jmp, ln2
    call _, new_syn
    load s_out, G+224
    call _, fix_last_tgt, s_out
    # jn menuju awal else
    call _, lbl_bind, s_nalse
    load tk, G+16
    call _, tkload, tk
    load sid2, G+176
    cmp sid2, 2
    jne si_elseblock
    call _, st_if                     # else if (struktur sendiri)
    call _, lbl_bind, s_out
    ret 0
si_elseblock:
    call _, expect_lbrace
    call _, tnext
    call _, walk_body, 0
    call _, lbl_bind, s_out
    ret 0
si_restore:
    call _, restore_pos
si_noelse:
    call _, lbl_bind, s_nalse
    ret 0
}

# save_pos / restore_pos — simpan G+16 ke G+696
fn save_pos {
    load t, G+16
    store G+696, t
    ret 0
}

fn restore_pos {
    load t, G+696
    store G+16, t
    ret 0
}

fn expect_lbrace {
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 8
    je elb_ok
    slen t_e, E_BRL
    load ln, G+288
    call _, die_line, E_BRL, t_e, ln
elb_ok:
    ret 0
}

# st_while — while kond { }  (break/continue)
fn st_while {
    load tk, G+16
    call _, tkload, tk
    load ln, G+288
    store G+288, ln
    call _, tnext
    # top loop
    call _, new_syn
    load s_top, G+224
    call _, lbl_bind, s_top
    load tk, G+16
    call _, tkload, tk
    call _, parse_cond
    call _, emit_cond_direct
    load s_end, G+224
    # dantarkan loop
    load n, G+72
    cmp n, 60
    jl sw_ok
    slen t_e, E_LBX
    call _, die_lbl, E_LBX, t_e
sw_ok:
    set q, n
    shl q, 4
    set p, LOOPS
    add p, q
    set v, s_top
    store p, v
    set t, n
    add t, 1
    store G+72, t
    call _, expect_lbrace
    call _, tnext
    call _, walk_body, 0
    # pulihkan slot loop
    load n2, G+72
    set t, n2
    sub t, 1
    store G+72, t
    # jmp top
    load ln2, G+288
    call _, e_jmp, ln2
    call _, fix_last_tgt, s_top
    # akhir loop
    call _, lbl_bind, s_end
    # patch break (kind 4, tgt = slot loop)
    call _, patch_breaks
    ret 0
}

# patch_breaks — scan FIX kind4 tgt == slot loop terakhir; patch ke pc kini
fn patch_breaks {
    load slot, G+72                   # slot = nloops SETELAH dikurangi
    set i, 0
pb_loop:
    load n, G+56
    cmp i, n
    jge pb_done
    set q, i
    shl q, 5
    set p, FIX
    add p, q
    add p, 8
    load k, p
    cmp k, 4
    jne pb_next
    add p, 8
    load t, p
    cmp t, slot
    jne pb_next
    # patch: rel = pc - (site-64+4)
    set q2, i
    shl q2, 5
    set p2, FIX
    add p2, q2
    load site, p2
    set rel, site
    sub rel, 64
    add rel, 4
    load pc, G+40
    set rel2, pc
    sub rel2, rel
    call _, patch32, site, rel2
    set q3, i
    shl q3, 5
    set p3, FIX
    add p3, q3
    add p3, 8
    set z, 0
    store p3, z                       # kind = 0 (selesai)
pb_next:
    set t, i
    add t, 1
    set i, t
    jmp pb_loop
pb_done:
    ret 0
}

# fix_last_break(slot) — nixup terakhir jadi kind 4 (break pending)
fn fix_last_break, slot {
    load n, G+56
    set q, n
    sub q, 1
    shl q, 5
    set p, FIX
    add p, q
    add p, 8
    set k, 4
    store p, k
    add p, 8
    load v, slot
    store p, v
    ret 0
}

# patch32(site, val) — tulis 4 byte di OUTB+site
fn patch32, site, val {
pt_ok:
    set p, OUTB
    set s, site
    add p, s
    set v, val
    set m, 255
    set t, v
    and t, m
    storeb p, t
    add p, 1
    set t, v
    shr t, 8
    and t, m
    storeb p, t
    add p, 1
    set t, v
    shr t, 16
    and t, m
    storeb p, t
    add p, 1
    set t, v
    shr t, 24
    and t, m
    storeb p, t
    ret 0
}

# st_bc(is_break)
fn st_bc, is_break {
    load n, G+72
    cmp n, 0
    jne bc_ok
    slen t_e, E_LOOP
    load ln, G+288
    call _, die_line, E_LOOP, t_e, ln
bc_ok:
    call _, tnext                     # lewati break/continue
    call _, endline_chk
    call _, tnext
    set b, is_break
    cmp b, 0
    je bc_cont
    load ln, G+288
    call _, e_jmp, ln
    load slot, G+72
    set t, slot
    sub t, 1
    call _, fix_push, 4, t, ln
    ret 0
bc_cont:
    load n2, G+72
    set t, n2
    sub t, 1
    set q, t
    shl q, 4
    set p, LOOPS
    add p, q
    load s_top, p
    load ln2, G+288
    call _, e_jmp, ln2
    call _, fix_last_tgt, s_top
    ret 0
}

# st_ret
fn st_ret {
    call _, tnext
    # nilai opsional: NL/RBRACE/EOF = ret 0
    call _, save_pos
    call _, skip_nl
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    set has, 1
    cmp k, 1
    je sr_none
    cmp k, 9
    je sr_none
    cmp k, 0
    je sr_none
    jmp sr_val
sr_none:
    call _, restore_pos
    set has, 0
sr_val:
    set h, has
    cmp h, 0
    je sr_emit
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_src
    call _, endline_chk
    call _, tnext
    jmp sr_go
sr_go:
    call _, emit_ret
    ret 0
sr_emit:
    set nk, -1
    store G+624, nk
    call _, emit_ret
    ret 0
}

# st_cmp — cmp a, b (raw)
fn st_cmp {
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_dst
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_src
    call _, endline_chk
    call _, tnext
    call _, emit_cmp_raw
    ret 0
}

# st_jump(op) — jmp/je/... ke label user
fn st_jump, op {
    set o, op
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 2
    je sj_lbl
    slen t_e, E_JMP
    load ln, G+288
    call _, die_line, E_JMP, t_e, ln
sj_lbl:
    load sid, G+176
    call _, tnext
    call _, endline_chk
    call _, tnext
    set o2, o
    cmp o2, 124
    je sj_jmp
    set o3, o
    call _, emit_jcc_raw, o3, sid
    ret 0
sj_jmp:
    load ln, G+288
    set s2, sid
    call _, e_jmp_lbl, s2, ln
    ret 0
}

# st_call — call dst, fn, args...
fn st_call {
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 1
    call _, save_dst
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 2
    je sc_nn
    slen t_e, E_CALL
    load ln, G+288
    call _, die_line, E_CALL, t_e, ln
sc_nn:
    load sid, G+176
    call _, fn_find, sid
    load fid, G+224
    cmp fid, -1
    jne sc_nound
    slen t_e, E_FNU
    slen t_n, E_FNU2
    load ln, G+288
    call _, die_line2, E_FNU, t_e, sid, E_FNU2, t_n, ln
sc_nound:
    call _, tnext
    # argumen: push LANGSUNG saat parsing (urutan maju)
    set z, 0
    store G+356, z
sc_args:
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 6
    jne sc_args_done
    call _, tnext
    load n, G+356
    cmp n, 6
    jl sc_room
    slen t_e, E_SYS
    load ln, G+288
    call _, die_line, E_SYS, t_e, ln
sc_room:
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    load k, G+192
    load v, G+200
    load o, G+208
    call _, ld_operand, 0, k, v, o
    call _, e_push_r, 0
    load n2, G+356
    set t, n2
    add t, 1
    store G+356, t
    jmp sc_args
sc_args_done:
    call _, endline_chk
    call _, tnext
    set n, fid
    call _, emit_call, n
    ret 0
}

# save_arg(n) — salin parse_operand ke G+360+n*24 (indeks eksplisit)
fn save_arg, n {
    set nn, n
    cmp nn, 0
    je sa_0
    cmp nn, 1
    je sa_1
    cmp nn, 2
    je sa_2
    cmp nn, 3
    je sa_3
    cmp nn, 4
    je sa_4
    jmp sa_5
sa_0:
    call _, save_arg_at, 360
    ret 0
sa_1:
    call _, save_arg_at, 384
    ret 0
sa_2:
    call _, save_arg_at, 408
    ret 0
sa_3:
    call _, save_arg_at, 432
    ret 0
sa_4:
    call _, save_arg_at, 456
    ret 0
sa_5:
    call _, save_arg_at, 480
    ret 0
}

fn save_arg_at, base {
    set b, base
    load k, G+192
    load v, G+200
    load o, G+208
    set p, G
    add p, b
    store p, k
    add p, 8
    store p, v
    add p, 8
    store p, o
    ret 0
}

# st_syskw — sys d, NR, a1..a6
fn st_syskw {
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 1
    call _, save_dst
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_nr                   # NR -> G+672/680/688
    # argumen
    set z, 0
    store G+356, z
    set i, 0
sy_loop:
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 6
    jne sy_done
    call _, tnext
    load n, G+356
    cmp n, 6
    jl sy_room
    slen t_e, E_SYS
    load ln, G+288
    call _, die_line, E_SYS, t_e, ln
sy_room:
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    load n2, G+356
    call _, save_arg, n2
    set t, n2
    add t, 1
    store G+356, t
    jmp sy_loop
sy_done:
    call _, endline_chk
    call _, tnext
    # emit: argumen -> register, NR -> rax, syscall
    set j, 0
sy_emit:
    load n3, G+356
    cmp j, n3
    jge sy_nr
    set j2, j
    call _, arg_kind, j2
    load k, G+192
    load v, G+200
    load o, G+208
    call _, sys_arg_reg, j2
    load r, G+224
    call _, emit_sys_arg, j2, k, v, o
    set t, j
    add t, 1
    set j, t
    jmp sy_emit
sy_nr:
    load k, G+672
    load v, G+680
    load o, G+688
    call _, ld_operand, 0, k, v, o
    call _, e_syscall
    load k, G+600
    load v, G+608
    load o, G+616
    call _, st_operand, k, v, o, 0
    ret 0
}

fn save_nr {
    load k, G+192
    load v, G+200
    load o, G+208
    store G+672, k
    store G+680, v
    store G+688, o
    ret 0
}

# arg_kind(i) — muat k/v/o arg i ke G+192/200/208 (untuk emit_sys_arg)
fn arg_kind, i {
    set nn, i
    cmp nn, 0
    je ak_0
    cmp nn, 1
    je ak_1
    cmp nn, 2
    je ak_2
    cmp nn, 3
    je ak_3
    cmp nn, 4
    je ak_4
    jmp ak_5
ak_0:
    load k, G+360
    load v, G+368
    load o, G+376
    store G+192, k
    store G+200, v
    store G+208, o
    ret 0
ak_1:
    load k, G+384
    load v, G+392
    load o, G+400
    store G+192, k
    store G+200, v
    store G+208, o
    ret 0
ak_2:
    load k, G+408
    load v, G+416
    load o, G+424
    store G+192, k
    store G+200, v
    store G+208, o
    ret 0
ak_3:
    load k, G+432
    load v, G+440
    load o, G+448
    store G+192, k
    store G+200, v
    store G+208, o
    ret 0
ak_4:
    load k, G+456
    load v, G+464
    load o, G+472
    store G+192, k
    store G+200, v
    store G+208, o
    ret 0
ak_5:
    load k, G+480
    load v, G+488
    load o, G+496
    store G+192, k
    store G+200, v
    store G+208, o
    ret 0
}

# st_printkw(which) — 0 printi, 1 prints, 2 printc
fn st_printkw, which {
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_dst
    set w, which
    cmp w, 1
    je sp_two
    call _, endline_chk
    call _, tnext
    set w2, which
    cmp w2, 0
    jne sp_pc
    call _, emit_printi
    ret 0
sp_pc:
    call _, emit_printc
    ret 0
sp_two:
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_src
    call _, endline_chk
    call _, tnext
    call _, emit_prints
    ret 0
}

# st_slenkw — slen d, label
fn st_slenkw {
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 1
    call _, save_dst
    call _, endline_expect_comma
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 2
    je ssl_lbl
    slen t_e, E_PTN
    load ln, G+288
    call _, die_line, E_PTN, t_e, ln
ssl_lbl:
    load sid, G+176
    call _, tnext
    call _, endline_chk
    call _, tnext
    set s2, sid
    call _, emit_slen, s2
    ret 0
}

# st_exitkw — exit kode
fn st_exitkw {
    call _, tnext
    load tk, G+16
    call _, tkload, tk
    call _, parse_operand, 0
    call _, save_dst
    call _, endline_chk
    call _, tnext
    call _, emit_exit
    ret 0
}

# ======================== EMIT PROGRAM ========================

# prologue — push rbp; mov rbp,rsp; sub rsp, 768 (bingkai tetap:
# ruang 96 slot lokal; push argumen call selalu DI BAWAH seluruh lokal,
# sehingga tak pernah menimpa slot [rbp-8k] walau nslots bertambah
# sepanjang badan fungsi. leave memulihkan rsp.)
fn prologue {
    call _, e_push_r, 5
    call _, e_mov_rr, 5, 4
    call _, e8, 72                     # sub rsp, 768 (48 81 EC 00030000)
    call _, e8, 129
    call _, e8, 236
    call _, e32, 768
    ret 0
}

# skip_fn_body — lewati 'fn ... }' tanpa registrasi (untuk walk __main__)
fn skip_fn_body {
    call _, tnext                      # 'fn'
    load tk, G+16
    call _, tkload, tk
    call _, tnext                      # nama
    load tk, G+16
    call _, tkload, tk
    load k, G+160
sf_params:
    cmp k, 6                           # COMMA
    jne sf_brace
    call _, tnext                      # param
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    jmp sf_params
sf_brace:
    call _, tnext                      # lewati param (tpos kini di '{')
    set depth, 0                       # '{' dihitung oleh sf_scan
sf_scan:
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 0
    je sf_done
    cmp k, 8
    jne sf_s2
    set t, depth
    add t, 1
    set depth, t
    call _, tnext
    jmp sf_scan
sf_s2:
    cmp k, 9
    jne sf_s3
    set t, depth
    sub t, 1
    set depth, t
    call _, tnext
    cmp depth, 0
    je sf_done
    jmp sf_scan
sf_s3:
    call _, tnext
    jmp sf_scan
sf_done:
    ret 0
}

# skip_data_decl — lewati 'data nama, "..." | N' tanpa registrasi
fn skip_data_decl {
    call _, tnext                      # 'data'
    call _, tnext                      # nama
    load tk, G+16
    call _, tkload, tk
    load k, G+160
    cmp k, 6
    je sd_comma
    ret 0
sd_comma:
    call _, tnext                      # str/num
    call _, tnext
    ret 0
}

# e_st_glob_rdi(goff) — mov [abs disp32], rdi
fn e_st_glob_rdi, goff {
    call _, e8, 72
    call _, e8, 137
    call _, e8, 60
    call _, e8, 37
    call _, e32, 0
    load g, goff
    call _, fix_push, 6, g, 0
    ret 0
}

fn e_st_glob_rsi, goff {
    call _, e8, 72
    call _, e8, 137
    call _, e8, 52
    call _, e8, 37
    call _, e32, 0
    load g, goff
    call _, fix_push, 6, g, 0
    ret 0
}

fn e_ld_glob_rdi, goff {
    call _, e8, 72
    call _, e8, 139
    call _, e8, 60
    call _, e8, 37
    call _, e32, 0
    load g, goff
    call _, fix_push, 6, g, 0
    ret 0
}

fn e_mov_ecx_imm, imm {
    call _, e8, 185
    load v, imm
    call _, e32, v
    ret 0
}

# emit_start — _start: simpan basis/ukuran arena, salin data image,
# call __main__, lalu exit(rax & 0xff)
fn emit_start {
    call _, e_st_glob_rdi, 0
    call _, e_st_glob_rsi, 8
    call _, e8, 190                    # mov esi, imm32 (alamat image data)
    call _, e32, 0
    call _, fix_push, 5, 0, 0
    call _, e_ld_glob_rdi, 0
    call _, e_mov_ecx_imm, 128
    call _, e_cld
    call _, e_repmovsb
    call _, e_call_f, 0, 0             # call __main__
    call _, e_mov_rr, 7, 0             # rdi = rax
    call _, e_mov_ri32, 0, 60
    call _, e_syscall
    ret 0
}

# emit_hidden_printi — __printi(rdi=nilai)
fn emit_hidden_printi {
    call _, e_mov_rr, 0, 7
    call _, e_ld_glob_r11, 0
    call _, e_test_rr, 0, 0
    call _, e_jcc, 13, 0               # jge L_pos
    call _, new_syn
    load s_pos, G+224
    call _, fix_last_tgt, s_pos
    call _, e8, 65                     # mov r10d, 45
    call _, e8, 186
    call _, e8, 45
    call _, e8, 0
    call _, e8, 0
    call _, e8, 68                     # mov byte [r11+85], r10b
    call _, e8, 136
    call _, e8, 83
    call _, e8, 85
    call _, e_mov_edi_imm, 1
    call _, e_mov_r_r11, 6
    call _, e_add_r_imm32, 6, 85
    call _, e_mov_edx_imm, 1
    call _, e_mov_ri32, 0, 1
    call _, e_syscall
    call _, e_neg_r, 0
    call _, lbl_bind, s_pos
    call _, e8, 69                     # xor r9d, r9d
    call _, e8, 49
    call _, e8, 201
    call _, e_test_rr, 0, 0
    call _, e_jcc, 5, 0                # jne L_loop
    call _, new_syn
    load s_loop, G+224
    call _, fix_last_tgt, s_loop
    call _, e8, 65                     # mov r10d, 48
    call _, e8, 186
    call _, e8, 48
    call _, e8, 0
    call _, e8, 0
    call _, e8, 68                     # mov byte [r11+127], r10b
    call _, e8, 136
    call _, e8, 83
    call _, e8, 127
    call _, e8, 65                     # mov r9d, 1
    call _, e8, 185
    call _, e8, 1
    call _, e8, 0
    call _, e8, 0
    call _, e_jmp, 0
    call _, new_syn
    load s_out, G+224
    call _, fix_last_tgt, s_out
    call _, lbl_bind, s_loop
    call _, e8, 72                     # xor edx, edx
    call _, e8, 49
    call _, e8, 210
    call _, e_mov_ecx_imm, 10
    call _, e8, 72                     # div rcx
    call _, e8, 247
    call _, e8, 241
    call _, e8, 128                    # add dl, 48
    call _, e8, 194
    call _, e8, 48
    call _, e_mov_r_r11, 6
    call _, e_add_r_imm32, 6, 127
    call _, e8, 76                     # sub rsi, r9
    call _, e8, 41
    call _, e8, 206
    call _, e8, 136                    # mov [rsi], dl
    call _, e8, 22
    call _, e8, 65                     # add r9, 1
    call _, e8, 255
    call _, e8, 193
    call _, e_test_rr, 0, 0
    call _, e_jcc, 5, 0
    call _, fix_last_tgt, s_loop
    call _, lbl_bind, s_out
    call _, e_mov_edi_imm, 1
    call _, e_mov_r_r11, 6
    call _, e_add_r_imm32, 6, 128
    call _, e8, 76
    call _, e8, 41
    call _, e8, 206
    call _, e8, 76                     # mov rdx, r9
    call _, e8, 137
    call _, e8, 202
    call _, e_mov_ri32, 0, 1
    call _, e_syscall
    call _, e_ret
    ret 0
}

# emit_hidden_die — __die(rdi=line, rsi=msg_off, rdx=len)
fn emit_hidden_die {
    call _, e_mov_rr, 3, 7             # rbx = line
    call _, e_mov_rr, 12, 2            # r12 = len
    call _, e8, 73                     # mov r13, rsi
    call _, e8, 137
    call _, e8, 245
    call _, e_ld_glob_r11, 0
    call _, e_mov_edi_imm, 2
    call _, e_mov_r_r11, 6
    call _, e_add_r_imm32, 6, 62
    call _, e_mov_edx_imm, 19
    call _, e_mov_ri32, 0, 1
    call _, e_syscall
    call _, e_mov_rr, 7, 3
    call _, e_call_f, -1, 0            # call __printi
    call _, e_mov_edi_imm, 2
    call _, e_mov_r_r11, 6
    call _, e_add_r_imm32, 6, 81
    call _, e_mov_edx_imm, 3
    call _, e_mov_ri32, 0, 1
    call _, e_syscall
    call _, e_mov_edi_imm, 2
    call _, e_mov_r_r11, 6
    call _, e8, 76                     # add rsi, r13
    call _, e8, 1
    call _, e8, 238
    call _, e_mov_rr, 2, 12
    call _, e_mov_ri32, 0, 1
    call _, e_syscall
    call _, e_mov_edi_imm, 2
    call _, e_mov_r_r11, 6
    call _, e_add_r_imm32, 6, 84
    call _, e_mov_edx_imm, 1
    call _, e_mov_ri32, 0, 1
    call _, e_syscall
    call _, e_mov_edi_imm, 1
    call _, e_mov_ri32, 0, 60
    call _, e_syscall
    ret 0
}

# emit_program — SATU PASS: _start, __main__, fn 1..n, hidden, data image
fn emit_program {
    set z, 0
    store G+40, z                      # pc = 0
    set t, OUTB
    add t, 64
    store G+128, t                     # ea = OUTB+64
    store G+64, z                      # nlbl
    store G+56, z                      # nfix
    store G+72, z                      # nloops
    store G+88, z                      # synlbl
    store G+552, z                     # vnt_n
    store G+720, z                     # suppress = 0
    set t, -2
    store G+576, t                     # HI_DIE
    # ---- _start ----
    call _, emit_start
    # ---- fn 0: __main__ ----
    set p, FNT
    add p, 16
    load c, G+40
    store p, c                         # FNT[0].start = pc
    store G+96, z                      # curfn
    store G+112, z                     # arity 0
    store G+104, z                     # nslots (hanya utk statistik)
    call _, var_reset
    call _, prologue
    store G+16, z                      # tpos = 0
    call _, walk_body, 1
    call _, e_xor_rax
    call _, e_leave
    call _, e_ret
    # ---- fn 1..nfn-1 ----
    set i, 1
ep_fn:
    load n, G+24
    cmp i, n
    jge ep_hidden
    set q, i
    set t5, 5
    mul q, t5
    shl q, 3                           # x40
    set p, FNT
    add p, q
    add p, 16
    load c, G+40
    store p, c                         # start = pc
    add p, -8
    load ar, p                         # arity (FNT+8)
    store G+112, ar
    set t, i
    store G+96, t
    store G+104, z
    call _, var_reset
    call _, prologue
    add p, 16                          # FNT+24 ptab_off
    load po, p
    set k, 0
ep_param:
    load a2, G+112
    cmp k, a2
    jge ep_mark
    set q, po
    add q, k
    shl q, 3
    set pp, PTAB
    add pp, q
    load sid, pp
    call _, var_define, sid
    set t, k
    add t, 1
    set k, t
    jmp ep_param
ep_mark:
    call _, params_mark
    set p2, FNT
    set q2, i
    set t5b, 5
    mul q2, t5b
    shl q2, 3
    add p2, q2
    add p2, 32
    load bt, p2
    store G+16, bt                     # tpos = awal badan
    call _, walk_body, 0
    call _, e_xor_rax
    call _, e_leave
    call _, e_ret
    set t, i
    add t, 1
    set i, t
    jmp ep_fn
ep_hidden:
    # __printi
    load c, G+40
    store G+560, c
    call _, emit_hidden_printi
    # __die
    load c, G+40
    store G+568, c
    call _, emit_hidden_die
    # data image
    load c, G+40
    store G+144, c                     # dimgpos
    set j, 0
ep_data:
    load nd, G+48
    cmp j, nd
    jge ep_done
    set p, GENIMG
    add p, j
    loadb b, p
    call _, e8, b
    set t, j
    add t, 1
    set j, t
    jmp ep_data
ep_done:
    ret 0
}

# ======================== RESOLVER & WRITER ========================

# resolve_fixups — patch semua rel32/abs32
fn resolve_fixups {
    set i, 0
rf_loop:
    load n, G+56
    cmp i, n
    jge rf_done
    set q, i
    shl q, 5
    set p, FIX
    add p, q
    load site, p
    add p, 8
    load kind, p
    add p, 8
    load tgt, p
    add p, 8
    load ln, p
    cmp kind, 0
    je rf_next
    cmp kind, 1
    je rf_lbl
    cmp kind, 2
    je rf_lbl
    cmp kind, 3
    je rf_fn
    cmp kind, 7
    je rf_fn
    cmp kind, 5
    je rf_dimg
    cmp kind, 6
    je rf_glob
    jmp rf_next
rf_lbl:
    call _, lbl_find, tgt
    load pc, G+224
    cmp pc, -1
    jne rf_lbl2
    slen t_e, E_LBLU
    slen t_n, E_LBLU2
    call _, die_line2, E_LBLU, t_e, tgt, E_LBLU2, t_n, ln
rf_lbl2:
    call _, rf_rel, site, pc
    jmp rf_next
rf_fn:
    set st, tgt
    cmp st, -1
    jne rf_fn2
    load st, G+560
    jmp rf_fnrel
rf_fn2:
    cmp st, -2
    jne rf_fn3
    load st, G+568
    jmp rf_fnrel
rf_fn3:
    set q, st
    set t5, 5
    mul q, t5
    shl q, 3
    set p2, FNT
    add p2, q
    add p2, 16
    load st, p2
rf_fnrel:
    call _, rf_rel, site, st
    jmp rf_next
rf_dimg:
    load d, G+144
    set v, 4194304
    add v, 64
    add v, d
    call _, patch32, site, v
    jmp rf_next
rf_glob:
    load dp, G+704
    set v, 4194304
    add v, dp
    add v, tgt
    call _, patch32, site, v
    jmp rf_next
rf_next:
    set t, i
    add t, 1
    set i, t
    jmp rf_loop
rf_done:
    ret 0
}

# rf_rel(site, target_pc) — patch rel32 = target - (site-64+4)
fn rf_rel, site, target_pc {
    set s, site
    set t, target_pc
    set rel, t
    set d, s
    sub d, 64
    add d, 4
    sub rel, d
    call _, patch32, s, rel
    ret 0
}

# write_image — header, resolver, tulis ke stdout / syscall 1000
fn write_image {
    load pc, G+40
    set dp, pc
    add dp, 64
    add dp, 4095
    set msk, -4096
    and dp, msk
    store G+704, dp
    call _, resolve_fixups
    # header 64B
    # magic u64 = IP_MAGIC inti-cc (byte LE: 'I','N','T','I','N','T','R','1')
    set p, OUTB
    set t, 73
    storeb p, t
    add p, 1
    set t, 78
    storeb p, t
    add p, 1
    set t, 84
    storeb p, t
    add p, 1
    set t, 73
    storeb p, t
    add p, 1
    set t, 78
    storeb p, t
    add p, 1
    set t, 84
    storeb p, t
    add p, 1
    set t, 82
    storeb p, t
    add p, 1
    set t, 49
    storeb p, t
    # entry_onn u32 @8 = 64 ; code_size @12 ; data_onn @16 ; data_size @20 = 16
    # arena_mb @24 = 32 ; stack @28 = 0
    call _, patch32, 8, 64
    load pc, G+40
    call _, patch32, 12, pc
    load dp, G+704
    call _, patch32, 16, dp
    call _, patch32, 20, 16
    call _, patch32, 24, 32
    call _, patch32, 28, 0
    # total = data_onn + 16 (globals 16B nol — sudah nol di buffer)
    load dp, G+704
    set tot, dp
    add tot, 16
    # tulis
    load mode, G+120
    cmp mode, 1
    je wi_intios
    # Linux: loop write stdout
    set done, 0
wi_lloop:
    set t, done
    cmp t, tot
    jge wi_nin
    set p, OUTB
    add p, t
    set lent, tot
    sub lent, t
    sys w, SYS_write, STDOUT, @p, lent
    cmp w, 0
    jle wi_err
    add t, w
    set done, t
    jmp wi_lloop
wi_err:
    slen t_e, E_WR
    call _, die_lbl, E_WR, t_e
wi_intios:
    set p, OUTB
    sys r, 1000, @p, tot
    cmp r, 0
    jl wi_err
wi_nin:
    ret 0
}
